/ {
	chosen {
		nordic,nus-uart = &cdc_acm_uart1;
	};

	aliases {
		buzzer-pwm = &buzzer;
	};

	buzzer: buzzer {
		status = "okay";
		pwms = <&pwm1 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
	};

	vbatt {
		compatible = "voltage-divider";
		io-channels = <&adc 2>;
		output-ohms = <180000>;
		full-ohms = <(1500000 + 180000)>;
		power-gpios = <&gpio0 16 0>;
	};
};

&zephyr_udc0 {
	cdc_acm_uart1: cdc_acm_uart1 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

&i2c1 {
	status = "okay";

	bme680: bme680@76 {
		compatible = "bosch,bme680";
		reg = <0x76>;
		status = "okay";
	};

	bh1749: bh1749@38 {
		compatible = "rohm,bh1749";
		reg = <0x38>;
		status = "okay";
	};
};

/* Enable BMI270 sensor on SPI (already defined in base device tree) */
&bmi270 {
	status = "okay";
};

/* PWM for buzzer on P1.15 (BZ1 on Thingy:53) */
&pwm1 {
	status = "okay";
	pinctrl-0 = <&pwm1_default>;
	pinctrl-1 = <&pwm1_sleep>;
	pinctrl-names = "default", "sleep";
};

&pinctrl {
	pwm1_default: pwm1_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 15)>;
		};
	};

	pwm1_sleep: pwm1_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 15)>;
			low-power-enable;
		};
	};
};

