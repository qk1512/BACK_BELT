/ {
	chosen {
		nordic,nus-uart = &cdc_acm_uart1;
	};
};

&zephyr_udc0 {
	cdc_acm_uart1: cdc_acm_uart1 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

&i2c1 {
	status = "okay";

	bme680: bme680@76 {
		compatible = "bosch,bme680";
		reg = <0x76>;
		status = "okay";
	};

	bh1749: bh1749@38 {
		compatible = "rohm,bh1749";
		reg = <0x38>;
		status = "okay";
	};
};

/* Enable BMI270 sensor on SPI (already defined in base device tree) */
&bmi270 {
	status = "okay";
};

